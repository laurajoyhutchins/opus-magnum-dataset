{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "atom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atom_id", "atom_type", "q", "r"],
      "properties": {
        "atom_id": {"type": "string", "minLength": 1},
        "atom_type": {"type": "string", "minLength": 1},
        "q": {"type": "integer"},
        "r": {"type": "integer"}
      }
    },
    "bond": {
      "type": "object",
      "additionalProperties": false,
      "required": ["a", "b", "bond_type"],
      "properties": {
        "a": {"type": "string", "minLength": 1},
        "b": {"type": "string", "minLength": 1},
        "bond_type": {"type": "string", "minLength": 1}
      }
    },
    "molecule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["molecule_id", "atoms", "bonds"],
      "properties": {
        "molecule_id": {"type": "string", "minLength": 1},
        "atoms": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/atom"}
        },
        "bonds": {
          "type": "array",
          "items": {"$ref": "#/$defs/bond"}
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "normalized_puzzle_id",
    "puzzle_id",
    "normalizer_version",
    "allowed_parts",
    "reagents",
    "products",
    "constraints"
  ],
  "properties": {
    "normalized_puzzle_id": {"type": "string", "minLength": 1},
    "puzzle_id": {"type": "string", "pattern": "^om\\.puzzle\\.\\d{4}$"},
    "normalizer_version": {"type": "string", "minLength": 1},
    "allowed_parts": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "reagents": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/molecule"}
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/molecule"}
    },
    "constraints": {"type": "object"}
  }
}
