{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private raw benchmark attempt custody manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "benchmark_id",
    "run_id",
    "puzzle_results_sha256",
    "attempts"
  ],
  "properties": {
    "schema": {
      "const": "om.benchmark-raw-attempts/v1"
    },
    "benchmark_id": {
      "type": "string",
      "pattern": "^om\\.benchmark\\.[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^om\\.benchmark-run\\.[0-9a-f]{64}$"
    },
    "puzzle_results_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "puzzle_id",
          "attempt_index",
          "raw_output_sha256",
          "raw_output_byte_length",
          "object_key",
          "outcome",
          "candidate_sha256",
          "error_code"
        ],
        "properties": {
          "puzzle_id": {
            "type": "string",
            "minLength": 1
          },
          "attempt_index": {
            "type": "integer",
            "minimum": 1
          },
          "raw_output_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "raw_output_byte_length": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4194304
          },
          "object_key": {
            "type": "string",
            "pattern": "^objects/sha256/[0-9a-f]{2}/[0-9a-f]{62}$"
          },
          "outcome": {
            "enum": [
              "output_compile_failed",
              "solution_parse_failed",
              "puzzle_solution_mismatch",
              "simulation_failed",
              "success"
            ]
          },
          "candidate_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "outcome": {
                  "const": "output_compile_failed"
                }
              },
              "required": [
                "outcome"
              ]
            },
            "then": {
              "properties": {
                "candidate_sha256": {
                  "type": "null"
                },
                "error_code": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "else": {
              "properties": {
                "candidate_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        ]
      }
    }
  }
}
