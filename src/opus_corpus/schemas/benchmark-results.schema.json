{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "benchmark_id": {
      "type": "string",
      "pattern": "^om\\.benchmark\\.[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^om\\.benchmark-run\\.[0-9a-f]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullable_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "verification_id": {
      "type": ["string", "null"],
      "pattern": "^om\\.verification\\.[0-9a-f]{64}$"
    },
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "nullable_counter": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "benchmark_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "benchmark_id",
        "protocol_version",
        "collection_id",
        "collection_manifest_sha256",
        "puzzle_serializer",
        "puzzle_serializer_version",
        "candidate_output_compiler",
        "candidate_output_compiler_version",
        "verifier_implementation",
        "verifier_revision",
        "verifier_sha256",
        "validation_profile",
        "attempt_profile",
        "attempt_budget",
        "scoring_version"
      ],
      "properties": {
        "record_type": {"const": "benchmark_identity"},
        "benchmark_id": {"$ref": "#/$defs/benchmark_id"},
        "protocol_version": {"$ref": "#/$defs/nonempty_string"},
        "collection_id": {"$ref": "#/$defs/nonempty_string"},
        "collection_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "puzzle_serializer": {"$ref": "#/$defs/nonempty_string"},
        "puzzle_serializer_version": {"$ref": "#/$defs/nonempty_string"},
        "candidate_output_compiler": {"$ref": "#/$defs/nonempty_string"},
        "candidate_output_compiler_version": {"$ref": "#/$defs/nonempty_string"},
        "verifier_implementation": {"$ref": "#/$defs/nonempty_string"},
        "verifier_revision": {"$ref": "#/$defs/nonempty_string"},
        "verifier_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "validation_profile": {"$ref": "#/$defs/nonempty_string"},
        "attempt_profile": {"$ref": "#/$defs/nonempty_string"},
        "attempt_budget": {"type": "integer", "minimum": 1},
        "scoring_version": {"$ref": "#/$defs/nonempty_string"}
      }
    },
    "benchmark_run_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "run_id",
        "benchmark_id",
        "system_id",
        "system_revision",
        "harness_implementation",
        "harness_revision",
        "generation_config_sha256"
      ],
      "properties": {
        "record_type": {"const": "benchmark_run_identity"},
        "run_id": {"$ref": "#/$defs/run_id"},
        "benchmark_id": {"$ref": "#/$defs/benchmark_id"},
        "system_id": {"$ref": "#/$defs/nonempty_string"},
        "system_revision": {"$ref": "#/$defs/nonempty_string"},
        "harness_implementation": {"$ref": "#/$defs/nonempty_string"},
        "harness_revision": {"$ref": "#/$defs/nonempty_string"},
        "generation_config_sha256": {"$ref": "#/$defs/nullable_sha256"}
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "benchmark_id",
        "run_id",
        "puzzle_id",
        "attempt_index",
        "outcome",
        "candidate_sha256",
        "verification_id",
        "cost",
        "cycles",
        "area",
        "instructions",
        "error_code",
        "model_calls",
        "input_tokens",
        "output_tokens",
        "verifier_calls"
      ],
      "properties": {
        "record_type": {"const": "attempt"},
        "benchmark_id": {"$ref": "#/$defs/benchmark_id"},
        "run_id": {"$ref": "#/$defs/run_id"},
        "puzzle_id": {"$ref": "#/$defs/nonempty_string"},
        "attempt_index": {"type": "integer", "minimum": 1},
        "outcome": {
          "enum": [
            "output_compile_failed",
            "solution_parse_failed",
            "puzzle_solution_mismatch",
            "simulation_failed",
            "success"
          ]
        },
        "candidate_sha256": {"$ref": "#/$defs/sha256"},
        "verification_id": {"$ref": "#/$defs/verification_id"},
        "cost": {"type": ["integer", "null"], "minimum": 0},
        "cycles": {"type": ["integer", "null"], "minimum": 0},
        "area": {"type": ["integer", "null"], "minimum": 0},
        "instructions": {"type": ["integer", "null"], "minimum": 0},
        "error_code": {"type": ["string", "null"], "minLength": 1},
        "model_calls": {"$ref": "#/$defs/nullable_counter"},
        "input_tokens": {"$ref": "#/$defs/nullable_counter"},
        "output_tokens": {"$ref": "#/$defs/nullable_counter"},
        "verifier_calls": {"type": "integer", "minimum": 0}
      },
      "allOf": [
        {
          "if": {
            "properties": {"outcome": {"const": "success"}},
            "required": ["outcome"]
          },
          "then": {
            "properties": {
              "verification_id": {
                "type": "string",
                "pattern": "^om\\.verification\\.[0-9a-f]{64}$"
              },
              "cost": {"type": "integer", "minimum": 0},
              "cycles": {"type": "integer", "minimum": 0},
              "area": {"type": "integer", "minimum": 0},
              "instructions": {"type": "integer", "minimum": 0},
              "error_code": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "cost": {"type": "null"},
              "cycles": {"type": "null"},
              "area": {"type": "null"},
              "instructions": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {"outcome": {"const": "output_compile_failed"}},
            "required": ["outcome"]
          },
          "then": {
            "properties": {
              "verification_id": {"type": "null"},
              "verifier_calls": {"const": 0}
            }
          },
          "else": {
            "properties": {
              "verification_id": {
                "type": "string",
                "pattern": "^om\\.verification\\.[0-9a-f]{64}$"
              },
              "verifier_calls": {"type": "integer", "minimum": 1}
            }
          }
        }
      ]
    },
    "puzzle_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "benchmark_id",
        "run_id",
        "puzzle_id",
        "attempts",
        "solved",
        "first_success_attempt"
      ],
      "properties": {
        "record_type": {"const": "puzzle_result"},
        "benchmark_id": {"$ref": "#/$defs/benchmark_id"},
        "run_id": {"$ref": "#/$defs/run_id"},
        "puzzle_id": {"$ref": "#/$defs/nonempty_string"},
        "attempts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/attempt"}
        },
        "solved": {"type": "boolean"},
        "first_success_attempt": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "outcome_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_compile_failed",
        "solution_parse_failed",
        "puzzle_solution_mismatch",
        "simulation_failed",
        "success"
      ],
      "properties": {
        "output_compile_failed": {"type": "integer", "minimum": 0},
        "solution_parse_failed": {"type": "integer", "minimum": 0},
        "puzzle_solution_mismatch": {"type": "integer", "minimum": 0},
        "simulation_failed": {"type": "integer", "minimum": 0},
        "success": {"type": "integer", "minimum": 0}
      }
    },
    "aggregate_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "benchmark",
        "run",
        "puzzle_count",
        "solved_count",
        "unsolved_count",
        "solve_rate_numerator",
        "solve_rate_denominator",
        "attempt_count",
        "outcome_counts",
        "verifier_calls",
        "model_calls",
        "input_tokens",
        "output_tokens",
        "puzzle_results_sha256"
      ],
      "properties": {
        "record_type": {"const": "aggregate_report"},
        "benchmark": {"$ref": "#/$defs/benchmark_identity"},
        "run": {"$ref": "#/$defs/benchmark_run_identity"},
        "puzzle_count": {"type": "integer", "minimum": 1},
        "solved_count": {"type": "integer", "minimum": 0},
        "unsolved_count": {"type": "integer", "minimum": 0},
        "solve_rate_numerator": {"type": "integer", "minimum": 0},
        "solve_rate_denominator": {"type": "integer", "minimum": 1},
        "attempt_count": {"type": "integer", "minimum": 1},
        "outcome_counts": {"$ref": "#/$defs/outcome_counts"},
        "verifier_calls": {"type": "integer", "minimum": 0},
        "model_calls": {"$ref": "#/$defs/nullable_counter"},
        "input_tokens": {"$ref": "#/$defs/nullable_counter"},
        "output_tokens": {"$ref": "#/$defs/nullable_counter"},
        "puzzle_results_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/benchmark_identity"},
    {"$ref": "#/$defs/benchmark_run_identity"},
    {"$ref": "#/$defs/attempt"},
    {"$ref": "#/$defs/puzzle_result"},
    {"$ref": "#/$defs/aggregate_report"}
  ]
}
