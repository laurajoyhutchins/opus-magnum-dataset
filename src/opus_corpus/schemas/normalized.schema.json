{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "integer"},
        "y": {"type": "integer"}
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part_id", "type", "x", "y", "rotation", "parameters"],
      "properties": {
        "part_id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "x": {"type": "integer"},
        "y": {"type": "integer"},
        "rotation": {"type": "integer", "minimum": 0, "maximum": 5},
        "parameters": {"type": "object"}
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["track_id", "coordinates"],
      "properties": {
        "track_id": {"type": "string", "minLength": 1},
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/coordinate"}
        }
      }
    },
    "instruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cycle", "opcode"],
      "properties": {
        "cycle": {"type": "integer", "minimum": 0},
        "opcode": {"type": "string", "minLength": 1}
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arm_id", "instructions"],
      "properties": {
        "arm_id": {"type": "string", "minLength": 1},
        "instructions": {
          "type": "array",
          "items": {"$ref": "#/$defs/instruction"}
        }
      }
    },
    "histogram": {
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "summaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "part_count",
        "track_count",
        "track_hex_count",
        "program_count",
        "instruction_count",
        "part_type_histogram",
        "opcode_histogram"
      ],
      "properties": {
        "part_count": {"type": "integer", "minimum": 0},
        "track_count": {"type": "integer", "minimum": 0},
        "track_hex_count": {"type": "integer", "minimum": 0},
        "program_count": {"type": "integer", "minimum": 0},
        "instruction_count": {"type": "integer", "minimum": 0},
        "part_type_histogram": {"$ref": "#/$defs/histogram"},
        "opcode_histogram": {"$ref": "#/$defs/histogram"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "normalized_solution_id",
    "solution_id",
    "puzzle_id",
    "normalizer_version",
    "parts",
    "tracks",
    "programs",
    "summaries"
  ],
  "properties": {
    "normalized_solution_id": {
      "type": "string",
      "pattern": "^om\\.normalized-solution\\.[0-9a-f]{64}$"
    },
    "solution_id": {"type": "string", "minLength": 1},
    "puzzle_id": {"type": "string", "pattern": "^om\\.puzzle\\.\\d{4}$"},
    "normalizer_version": {"type": "string", "minLength": 1},
    "parts": {"type": "array", "items": {"$ref": "#/$defs/part"}},
    "tracks": {"type": "array", "items": {"$ref": "#/$defs/track"}},
    "programs": {"type": "array", "items": {"$ref": "#/$defs/program"}},
    "summaries": {"$ref": "#/$defs/summaries"}
  }
}
